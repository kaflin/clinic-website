# Copy this file to .env and fill it in. Never commit .env.

# "development" on your own machine, "production" on the server.
NODE_ENV=development
PORT=3000

# The public address of the site, with no slash at the end.
# In production this must be the https address. It is used for canonical
# links, the sitemap and the redirect to one version of the domain.
SITE_URL=http://localhost:3000

# A long random string. Make a new one for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=

# MySQL. Use the app's own user, never root. See db/schema.sql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=clinic_app
DB_PASSWORD=
DB_NAME=clinic_website

# Email to the front desk when a request arrives. Leave SMTP_HOST empty to
# switch the email off. The request is still saved in the database.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
FRONT_DESK_EMAIL=
