<%
  const fullTitle = `${meta.title} | ${clinicName}`;
  const canonical = siteUrl + (meta.path === '/' ? '/' : meta.path);
  const ogImage = `${siteUrl}/images/${meta.image || 'og-default.png'}`;
-%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= fullTitle %></title>
<meta name="description" content="<%= meta.description %>">
<% if (meta.noindex) { -%>
<meta name="robots" content="noindex">
<% } else { -%>
<link rel="canonical" href="<%= canonical %>">
<% } -%>
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= clinicName %>">
<meta property="og:title" content="<%= fullTitle %>">
<meta property="og:description" content="<%= meta.description %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:image" content="<%= ogImage %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Source+Sans+3:wght@400;500;600&display=swap">
<link rel="stylesheet" href="<%= assets.css.path %>">
<% (meta.jsonLd || []).forEach((item) => { -%>
<%# Trusted data from node_app/server/data only, with "<" escaped by toScriptJson. -%>
<script type="application/ld+json"><%- toScriptJson(item) %></script>
<% }) -%>
<script src="<%= assets.js.path %>" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to the main content</a>
