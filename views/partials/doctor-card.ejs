<article class="card doctor-card">
  <%- include('doctor-photo', { doctor, photoClass: 'doctor-card__photo', lazy: true }) %>
  <div class="doctor-card__body">
    <h3><a href="/doctors/<%= doctor.slug %>"><%= fact(doctor.name, 'DOCTOR NAME') %></a></h3>
    <p class="text-muted"><%= fact(doctor.qualifications, 'QUALIFICATIONS') %></p>
    <p><%= fact(doctor.role, 'ROLE') %></p>
  </div>
</article>
